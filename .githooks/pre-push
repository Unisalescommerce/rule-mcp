#!/bin/sh
# rule-mcp: validate the commits a push would send, then formatting.
#
# The commit gate runs first: a push carrying a non-conforming message is
# blocked with the sha, the message and the reason. The binary answers when it
# is on PATH; the repository validator answers otherwise. The rule lives in
# src/core/commit, so the same implementation answers the commit-msg hook, this
# gate and CI. Formatting stays local: the binary does not run Prettier.
#
# Install: pnpm hooks:install
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: checking commit messages..."

if command -v rule-mcp >/dev/null 2>&1; then
  rule-mcp commit-lint --stdin-push
else
  node scripts/build/commit-types/index.mjs --stdin-push
fi

echo "pre-push: checking formatting..."

if ! pnpm format --no-color 2>&1; then
  echo "" >&2
  echo "pre-push: rejected - unformatted files detected." >&2
  echo "  Run: pnpm format:fix" >&2
  echo "  Then stage and push again." >&2
  exit 1
fi

echo "pre-push: commit messages and formatting ok"
