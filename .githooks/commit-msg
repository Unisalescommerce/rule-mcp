#!/bin/sh
# rule-mcp: enforce type(scope): subject.
#
# One gate, two implementations: the installed binary when it is on PATH, the
# repository validator otherwise. The rule lives in src/core/commit, so the
# hook, pre-push and CI cannot drift apart.
#
#   format:   type(scope): subject
#   example:  feat(skills): add rule-mcp naming
#   rejected: docs: port documentation
#
# Install: pnpm hooks:install
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

msg_file="$1"
first="$(sed -n '1p' "$msg_file" 2>/dev/null)"

# System-generated messages (merge / revert) cannot carry a scope.
case "$first" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

# `command -v` passes for a launcher whose target moved. The probe asks whether it
# answers, so a broken binary falls back to the in-repo validator instead of
# turning exit 1 from node into a rejected commit.
if command -v rule-mcp >/dev/null 2>&1 && rule-mcp --version >/dev/null 2>&1; then
  exec rule-mcp commit-lint --msg-file "$msg_file"
fi

exec node scripts/build/commit-types/index.mjs --msg-file "$msg_file"
